[Unit]
Description=Private household accounts dashboard (Tailscale Serve backend)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/planner/_local/accounts
ExecStart=%h/.local/share/planner-accounts-venv/bin/python %h/planner/_local/accounts/server.py --port 8765 --bridge --hosted --hosted-env %h/.config/planner-accounts/hosted.env
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
